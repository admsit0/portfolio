% shared-style.sty — Consistent scientific paper style for reconversion documents
% Clean, modern aesthetic inspired by academic journals

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shared-style}[2026/10/01 Shared style for reconverted papers]

% ── Geometry ──────────────────────────────────────────────────────────────────
\RequirePackage[
  a4paper,
  top=2.5cm,
  bottom=2.5cm,
  left=2.5cm,
  right=2.5cm,
  headheight=14pt
]{geometry}

% ── Fonts ─────────────────────────────────────────────────────────────────────
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}            % Latin Modern (clean, modern serif)
\RequirePackage{microtype}          % Microtypographic improvements

% ── Colors ────────────────────────────────────────────────────────────────────
\RequirePackage[dvipsnames,svgnames,x11names]{xcolor}

% Elegant deep blue palette
\definecolor{accentblue}{HTML}{1A3C6D}
\definecolor{linkblue}{HTML}{2563EB}
\definecolor{codebg}{HTML}{F5F7FA}
\definecolor{codeborder}{HTML}{D1D5DB}
\definecolor{captioncolor}{HTML}{374151}
\definecolor{rulegray}{HTML}{9CA3AF}
\definecolor{titlegray}{HTML}{111827}

% ── Math ──────────────────────────────────────────────────────────────────────
\RequirePackage{amsmath,amssymb,amsfonts}

% ── Graphics & Floats ────────────────────────────────────────────────────────
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{subcaption}

% ── Captions ──────────────────────────────────────────────────────────────────
\RequirePackage[
  font={small,color=captioncolor},
  labelfont={bf,color=accentblue},
  labelsep=period,
  justification=centering
]{caption}

% ── Section headings ─────────────────────────────────────────────────────────
\RequirePackage{titlesec}

\titleformat{\section}
  {\Large\bfseries\color{accentblue}}
  {\thesection.}{0.5em}{}
  [\vspace{-0.3em}{\color{rulegray}\rule{\textwidth}{0.5pt}}]

\titleformat{\subsection}
  {\large\bfseries\color{accentblue!85!black}}
  {\thesubsection.}{0.5em}{}

\titleformat{\subsubsection}
  {\normalsize\bfseries\color{accentblue!70!black}}
  {\thesubsubsection.}{0.5em}{}

\titlespacing*{\section}{0pt}{1.8em}{0.8em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.3em}

% ── Headers & Footers ────────────────────────────────────────────────────────
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textit{\@shorttitle}}
\fancyhead[R]{\small\thepage}
\fancyfoot[C]{\small\textcolor{rulegray}{\@shortauthors}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Store short title and authors for headers
\newcommand{\@shorttitle}{}
\newcommand{\shorttitle}[1]{\renewcommand{\@shorttitle}{#1}}
\newcommand{\@shortauthors}{}
\newcommand{\shortauthors}[1]{\renewcommand{\@shortauthors}{#1}}

% ── Hyperlinks ────────────────────────────────────────────────────────────────
\RequirePackage[
  colorlinks=true,
  linkcolor=accentblue,
  citecolor=accentblue!80!black,
  urlcolor=linkblue,
  bookmarks=true,
  pdfstartview=FitH
]{hyperref}

% ── Code listings ─────────────────────────────────────────────────────────────
\RequirePackage{listings}

\lstset{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebg},
  frame=single,
  rulecolor=\color{codeborder},
  framesep=4pt,
  xleftmargin=6pt,
  xrightmargin=6pt,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  numbers=left,
  numberstyle=\tiny\color{rulegray},
  numbersep=8pt,
  tabsize=4,
  keywordstyle=\color{accentblue}\bfseries,
  commentstyle=\color{rulegray}\itshape,
  stringstyle=\color{DarkGreen},
  captionpos=b,
  aboveskip=1em,
  belowskip=0.5em,
}

\lstdefinestyle{python}{
  language=Python,
  morekeywords={self,True,False,None,as,with,lambda,yield,async,await},
}

\lstdefinestyle{sql}{
  language=SQL,
  morekeywords={EXPLAIN,ANALYZE,VACUUM,INDEX,USING,HASH,BTREE,CLUSTER},
}

% ── Enumerations ──────────────────────────────────────────────────────────────
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=*}
\setlist[itemize]{label={\color{accentblue}\textbullet}}
\setlist[enumerate]{label={\color{accentblue}\arabic*.}}

% ── Title block ───────────────────────────────────────────────────────────────
\newcommand{\papertitle}[1]{%
  \begin{center}
    {\LARGE\bfseries\color{titlegray} #1\par}
    \vspace{0.6em}
  \end{center}
}

\newcommand{\paperauthors}[1]{%
  \begin{center}
    {\large #1\par}
    \vspace{0.3em}
  \end{center}
}

\newcommand{\paperdate}[1]{%
  \begin{center}
    {\small\textcolor{rulegray}{#1}\par}
    \vspace{0.3em}
    {\color{rulegray}\rule{0.4\textwidth}{0.5pt}\par}
    \vspace{1.5em}
  \end{center}
}

% ── Abstract environment ─────────────────────────────────────────────────────
\renewenvironment{abstract}{%
  \begin{center}
    \begin{minipage}{0.9\textwidth}
      \vspace{0.5em}
      {\small\bfseries\color{accentblue} Abstract\par}\vspace{0.3em}
      \small
}{%
      \vspace{0.5em}
    \end{minipage}
  \end{center}
  \vspace{1em}
}

% ── Useful extras ─────────────────────────────────────────────────────────────
\RequirePackage{placeins}           % \FloatBarrier
\RequirePackage{tabularx}

\endinput
